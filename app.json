{
  "expo": {
    "name": "nuvora",
    "slug": "nuvora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/nuvora_logo.png",
    "scheme": "nuvora",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/logo/nuvora_logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#282744",
        "foregroundImage": "./assets/logo/nuvora_logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/logo/nuvora_logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/logo/nuvora_logo.png",
          "imageWidth": 80
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "vi",
              "en"
            ],
            "android": [
              "vi",
              "en"
            ]
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Cho phép Nuvora dùng Face ID để mở khóa dữ liệu tài chính của bạn."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
